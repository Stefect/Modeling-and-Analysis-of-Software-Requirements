@startuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam shadowing false

top to bottom direction
skinparam linetype ortho

skinparam ranksep 190
skinparam nodesep 140
skinparam ArrowFontSize 10
skinparam packagePadding 55
title Component Diagram — Мультивендорний маркетплейс (Завдання 5, Варіант 3)
package "Клієнт" #E3F2FD {
  [Web Client (SPA)] as WebClient
}

package "API" #E8F5E9 {
  [API Gateway / BFF] as Gateway
}

package "Сервіси" #FFFDE7 {
  [Order Service] as OrderService
  [Catalog Service] as CatalogService
  [Review Service] as ReviewService
  [Seller Service] as SellerService
  [Auth Service] as AuthService
  [Notification Service] as NotificationService
}
package "Інфраструктура та Дані" #FFF3E0 {
  [Order Data Access] as OrderRepo
  [Catalog Data Access] as CatalogRepo
  [Review Data Access] as ReviewRepo
  [Seller Data Access] as SellerRepo
  [Auth Data Access] as AuthRepo
  [Payment Adapter] as PaymentAdapter
  [Order Expiry Scheduler] as ExpiryScheduler
  [Outbox Relay Worker] as OutboxRelay
  
  database "PostgreSQL" as Database
}

package "Зовнішні системи" #F3E5F5 {
  [Payment Gateway] as PaymentGateway
  [Identity Provider] as IdentityProvider
  [Email / SMS Provider] as EmailProvider
}
' --- Суворе вирівнювання колонок ---
OrderService -[hidden]right-> CatalogService
CatalogService -[hidden]right-> ReviewService
ReviewService -[hidden]right-> SellerService
SellerService -[hidden]right-> AuthService
AuthService -[hidden]right-> NotificationService

OrderRepo -[hidden]right-> CatalogRepo
CatalogRepo -[hidden]right-> ReviewRepo
ReviewRepo -[hidden]right-> SellerRepo
SellerRepo -[hidden]right-> AuthRepo
AuthRepo -[hidden]right-> PaymentAdapter
PaymentAdapter -[hidden]right-> ExpiryScheduler
ExpiryScheduler -[hidden]right-> OutboxRelay

PaymentGateway -[hidden]right-> IdentityProvider
IdentityProvider -[hidden]right-> EmailProvider
' --- Фіксація ярусів ---
WebClient -[hidden]down-> Gateway
Gateway -[hidden]down-> ReviewService
PaymentAdapter -[hidden]down-> PaymentGateway
AuthService -[hidden]down-> IdentityProvider
NotificationService -[hidden]down-> EmailProvider

' === 1. Клієнт -> API ===
WebClient -(0- Gateway : \nIAuthApi, IOrderApi,\nISellerApi, ICatalogApi, IReviewApi
' === 2. API -> Сервіси ===
Gateway -(0- OrderService : \nIOrderService
Gateway -(0- CatalogService : \nICatalogService
Gateway -(0- ReviewService : \nIReviewService
Gateway -(0- SellerService : \nISellerService
Gateway -(0- AuthService : \nIAuthService
' === 3. Сервіси -> Інфраструктура ===
OrderService -(0- OrderRepo : \nIOrderRepository,\nIProductRepository,\nIOutboxRepository
CatalogService -(0- CatalogRepo : \nIProductRepository,\nICategoryRepository,\nIStoreRepository
ReviewService -(0- ReviewRepo : \nIReviewRepository
SellerService -(0- SellerRepo : \nIStoreRepository,\nIProductRepository
AuthService -(0- AuthRepo : \nIUserRepository

OrderService -(0- PaymentAdapter : \nIPaymentGateway
OrderService -0)- ExpiryScheduler : \nIOrderService
OutboxRelay -(0- OrderRepo : \nIOutboxRepository
NotificationService -0)- OutboxRelay : \nIEmailSender
' === 4. Доступ до БД та Зовнішні системи ===
OrderRepo -(0- Database : \nIDbConnection
CatalogRepo -(0- Database : \nIDbConnection
ReviewRepo -(0- Database : \nIDbConnection
SellerRepo -(0- Database : \nIDbConnection
AuthRepo -(0- Database : \nIDbConnection

PaymentAdapter ..> PaymentGateway : зовнішній API
AuthService -(0- IdentityProvider : \nIIdentityProvider
NotificationService ..> EmailProvider : зовнішній API

@enduml
